#
# adn-report-proxy — optional legacy report wire adapter
#
# Legacy dashboard (dashboard.py / monitor.py) connects to LISTEN.
# Proxy connects upstream to adn-server 2.x (or v1 passthrough).

UPSTREAM:
  HOST: "127.0.0.1"
  PORT: 4321
  # adn-server REPORTS.REPORT_CLIENTS must allow the proxy host (often 127.0.0.1).

LISTEN:
  HOST: ""
  PORT: 4322

LOGGER:
  LOG_LEVEL: INFO
